{
  "name": "@defra/lis-hubs-infra-core",
  "version": "0.0.1",
  "description": "Shared hub mechanics for livestock platform.",
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/DEFRA/lis-hubs-infra-core.git"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,cjs,md,json}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,cjs,md,json}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=istanbul --coverage.reporter=text --coverage.reporter=lcov --coverage.include=\"src/**/*.js\"",
    "prepare": "if [ \"$npm_command\" = \"install\" ] && [ -z \"$CI\" ] && command -v husky >/dev/null 2>&1; then husky; fi",
    "security-audit": "audit-ci",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-sts": "3.1163.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/h2o2": "10.0.4",
    "@hapi/wreck": "^18.1.2",
    "hapi-pino": "13.0.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0"
  },
  "devDependencies": {
    "@defra/lis-hubs-infra-registry": "^0.13.6",
    "@defra/lis-infra-eslint-config": "^0.12.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^5.1.0",
    "audit-ci": "^7.1.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@defra/lis-hubs-infra-registry": ">=0.13.0 <1.0.0"
  }
}
